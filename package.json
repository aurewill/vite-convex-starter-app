    "@tanstack/react-router": "1.170.46",
    "@vite-convex-starter-app/utils": "workspace:*",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "convex": "1.48.0",
    "lucide-react": "1.61.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "4.22.1",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "5.0.0",
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.48",
